rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /products/{uid}/{pid}/main {
   allow read: if true;
   allow create: if resource == null && request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
    && request.resource.size <= 2 * 1024 * 1024
    && request.resource.contentType.matches('image/(jpeg|png|webp)');
   // Images are immutable after upload: prevents changing an auction item after bids.
   allow update, delete: if false;
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
