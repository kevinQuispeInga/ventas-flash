    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/domain.test.mjs tests/demo.test.mjs tests/radar.test.mjs tests/live.test.mjs tests/seed.test.mjs tests/unification.test.mjs tests/supabase.test.mjs tests/supabase-client.test.mjs tests/errors.test.mjs",
    "test:supabase": "node --test tests/supabase.test.mjs tests/supabase-client.test.mjs",
    "dev:demo": "vite --host 0.0.0.0 --mode demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
